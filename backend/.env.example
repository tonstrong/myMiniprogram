APP_ENV=development
APP_PORT=4000
PUBLIC_BASE_URL=https://zwyi.xin
MAX_UPLOAD_BYTES=10485760
LOG_LEVEL=info

DATABASE_URL=mysql://root:replace_me@127.0.0.1:3306/test
QUEUE_URL=memory://
STORAGE_PROVIDER=local
STORAGE_BUCKET=closet-assets

# Provider-agnostic LLM gateway configuration. The backend uses OpenAI-compatible
# /v1/chat/completions APIs and will append /v1 when the base URL omits it.
LLM_PROVIDERS=sub2api
LLM_PROVIDER_PRIORITY=sub2api
LLM_PROVIDER_TIMEOUT_MS=20000
LLM_PROVIDER_RETRY_LIMIT=2

WEATHER_PROVIDER=qweather
WEATHER_API_KEY=replace_me
WEATHER_TTL_SECONDS=600

# WeChat Mini Program login. Required in MySQL mode so the same WeChat user maps
# to the same persistent account after reinstalling or clearing local storage.
WECHAT_APP_ID=replace_me
WECHAT_APP_SECRET=replace_me
AUTH_TOKEN_SECRET=replace_with_a_long_random_secret
INTERNAL_API_TOKEN=replace_with_a_long_random_internal_token

# AI recognition quota exemptions. WeChat Mini Programs cannot read a user's
# WeChat ID, so prefer stable backend user IDs or real openids/unionids.
AI_EXTRACTION_DAILY_LIMIT=3
AI_EXTRACTION_EXEMPT_USER_IDS=
AI_EXTRACTION_EXEMPT_WECHAT_OPEN_IDS=
AI_EXTRACTION_EXEMPT_UNION_IDS=
WORKER_POLL_INTERVAL_MS=1500
WORKER_LEASE_MS=90000
WORKER_DAILY_HOME_SWEEP_INTERVAL_MS=600000
WORKER_TIME_ZONE=Asia/Shanghai

# Optional helper for one-off migration scripts when you need to rewrite
# historical asset URLs from an old IP/domain to PUBLIC_BASE_URL.
OLD_PUBLIC_BASE_URLS=http://39.97.158.168:4000

# Supported key styles:
# - Preferred: LLM_PROVIDER_SUB2API_*
# - Backward compatible: LLM_PROVIDER_PROVIDER_SUB2API_*

LLM_PROVIDER_SUB2API_BASE_URL=https://zwyi.xin/sub2api
LLM_PROVIDER_SUB2API_API_KEY=replace_me
LLM_PROVIDER_SUB2API_MODEL=gpt-4o-mini
LLM_PROVIDER_SUB2API_MODEL_TIER=standard

# Example: Alibaba Cloud DashScope (Qwen)
# LLM_PROVIDER_DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_PROVIDER_DASHSCOPE_API_KEY=your_api_key_here
# LLM_PROVIDER_DASHSCOPE_MODEL=qwen-plus
