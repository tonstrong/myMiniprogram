{
  "name": "closet-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx src/main.ts",
    "dev:all": "node scripts/dev-all.mjs",
    "worker": "tsx src/workers/main.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:migrate:status": "tsx scripts/migrate-status.ts",
    "rewrite:image-base-url": "tsx scripts/rewrite-image-base-url.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "mysql2": "^3.21.1",
    "openai": "^6.34.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "tsx": "^4.15.4",
    "typescript": "^5.5.4",
    "typescript-language-server": "^5.1.3"
  }
}
