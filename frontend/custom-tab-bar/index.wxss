.custom-tab-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 110rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  display: flex;
  padding-bottom: env(safe-area-inset-bottom);
  box-shadow: 0 -8rpx 40rpx rgba(0, 0, 0, 0.05);
  border-top: 1rpx solid rgba(255, 255, 255, 0.4);
  border-radius: 32rpx 32rpx 0 0; /* 相比140rpx稍微调小一点圆角以匹配比例 */
  z-index: 9999;
  box-sizing: content-box;
}

.tab-bar-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: center;
  color: #A1A1A5;
  position: relative;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  margin-top: -6rpx;
}

.tab-bar-item.active {
  color: #1C1C1E;
}

.icon-container {
  position: relative;
  width: 56rpx;
  height: 56rpx;
  margin-bottom: 8rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-bar-item.active .icon-container {
  transform: translateY(-4rpx) scale(1.1);
}

/* 文本加入细致的排版 */
.text {
  font-size: 22rpx;
  font-weight: 500;
  line-height: 1;
  transition: all 0.4s;
  letter-spacing: 0.5rpx; /* 增加一点字间距，提升精致感 */
}

.tab-bar-item.active .text {
  font-size: 24rpx;
  font-weight: 700;
  color: #1C1C1E;
}

/* --- 纯 CSS 抽象质感图标 --- */
.icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  transition: all 0.3s;
}

/* 首页图标 */
.icon-home {
  border: 4rpx solid currentColor;
  border-radius: 12rpx 12rpx 6rpx 6rpx;
  height: 34rpx;
  width: 36rpx;
  margin-top: 6rpx;
}
.icon-home::before {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%) rotate(45deg);
  width: 24rpx;
  height: 24rpx;
  border-top: 4rpx solid currentColor;
  border-left: 4rpx solid currentColor;
  border-radius: 4rpx 0 0 0;
}
.tab-bar-item.active .icon-home {
  background-color: currentColor;
}

/* 衣橱图标 */
.icon-closet {
  border: 4rpx solid currentColor;
  border-radius: 8rpx;
  height: 38rpx;
  width: 34rpx;
  margin-top: 4rpx;
}
.icon-closet::before {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 4rpx;
  background-color: currentColor;
  border-radius: 4rpx;
}
.tab-bar-item.active .icon-closet {
  background-color: currentColor;
}
.tab-bar-item.active .icon-closet::before {
  background-color: #FFF;
}

/* 我的/个人中心 图标 */
.icon-profile {
  border: 4rpx solid currentColor;
  border-radius: 50%;
  width: 38rpx;
  height: 38rpx;
  position: relative;
  margin-top: 4rpx;
}
.icon-profile::before {
  content: '';
  position: absolute;
  top: 18%;
  left: 50%;
  transform: translateX(-50%);
  width: 14rpx;
  height: 14rpx;
  border: 4rpx solid currentColor;
  border-radius: 50%;
}
.icon-profile::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 22rpx;
  height: 8rpx;
  border: 4rpx solid currentColor;
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}
.tab-bar-item.active .icon-profile {
  background-color: currentColor;
}
.tab-bar-item.active .icon-profile::before {
  border-color: #FFF;
  background-color: transparent;
}
.tab-bar-item.active .icon-profile::after {
  border-color: #FFF;
  background-color: currentColor;
}
