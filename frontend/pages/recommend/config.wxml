<view class="container no-pad flex-col h-full">
  <view class="weather-bar flex-row items-center animate-fade-in">
    <text class="wx-icon">☼</text>
    <view class="flex-col ml-sm weather-copy">
      <text class="text-body font-medium">{{weather}}</text>
      <text wx:if="{{cityName}}" class="weather-city">当前城市：{{cityName}}</text>
    </view>
    <button
      wx:if="{{!hasCity || cityBusy}}"
      class="btn-secondary weather-guide-btn"
      bindtap="openCityGuide"
      loading="{{cityBusy}}"
    >
      {{cityBusy ? '定位中' : '设置城市'}}
    </button>
  </view>

  <view class="config-content flex-col animate-fade-in" style="animation-delay: 0.1s;">
    <view class="history-entry glass-panel" bindtap="openHistory">
      <view class="history-icon">历</view>
      <view class="flex-col history-entry-copy">
        <text class="history-entry-title">推荐历史</text>
        <text class="history-entry-desc">查看生成中的任务和过往推荐结果</text>
      </view>
      <text class="history-entry-arrow">></text>
    </view>

    <view class="c-group">
      <text class="c-title">前往什么场景？</text>
      <view class="c-options flex-row mt-md">
        <block wx:for="{{scenes}}" wx:key="*this">
          <view class="c-chip {{activeScene === item ? 'active' : ''}}" bindtap="selectScene" data-scene="{{item}}">
            {{item}}
          </view>
        </block>
      </view>
    </view>

    <view class="c-group mt-xl">
      <text class="c-title">想套用哪种风格逻辑？</text>
      <text class="text-caption text-tertiary mt-xs">AI 会参考风格包里的搭配偏好来生成推荐。</text>
      <view class="c-list mt-md">
        <block wx:for="{{stylePacks}}" wx:key="id">
          <view class="pack-row flex-row items-center justify-between {{selectedPack === item.id ? 'active' : ''}}" bindtap="selectPack" data-id="{{item.id}}">
            <text class="text-body">{{item.name}}</text>
            <view class="radio-ind {{selectedPack === item.id ? 'checked' : ''}}"></view>
          </view>
        </block>
      </view>
    </view>
  </view>

  <view class="action-fixed">
    <button
      class="btn-primary w-full shadow-glow"
      bindtap="generateLook"
      loading="{{isGenerating}}"
    >
      {{isGenerating ? '正在生成搭配...' : '开始生成灵感图集'}}
    </button>
  </view>
</view>
