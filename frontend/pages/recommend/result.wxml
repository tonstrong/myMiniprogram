<view class="container dark-theme flex-col">
  <block wx:if="{{status === 'processing'}}">
    <view class="pending-shell flex-col items-center justify-center">
      <view class="pending-orb"></view>
      <text class="page-title text-h2 text-center">灵感图集中生成中</text>
      <text class="pending-copy text-caption">你不用一直等着，结果会在这里自动刷新。</text>
      <text class="pending-copy text-caption">生成完成后，再决定要不要同步到画布。</text>
      <button class="pending-btn btn-secondary" bindtap="goBackToConfig">先返回上一页</button>
    </view>
  </block>

  <block wx:elif="{{status === 'failed'}}">
    <view class="pending-shell flex-col items-center justify-center">
      <text class="page-title text-h2 text-center">这次生成失败了</text>
      <text class="pending-copy text-caption">可以返回上一页调整场景、风格包或衣橱后再试一次。</text>
      <button class="pending-btn btn-secondary" bindtap="goBackToConfig">返回重试</button>
    </view>
  </block>

  <block wx:else>
    <text class="page-title text-h2 text-center animate-fade-in">为你生成了 {{looks.length}} 套搭配</text>

    <swiper class="look-swiper animate-fade-in" style="animation-delay: 0.1s;" previous-margin="40rpx" next-margin="40rpx" bindchange="onSwiperChange">
      <block wx:for="{{looks}}" wx:key="id">
        <swiper-item class="si-wrap">
          <view class="look-card {{currentSwipe === index ? 'active' : ''}} flex-col">
            <view class="collage-area flex-row">
              <block wx:for="{{item.items}}" wx:key="id" wx:for-item="cloth">
                <view class="cloth-item" style="flex: {{cloth.type === '下装' ? 1.5 : (cloth.type === '鞋履' ? 0.8 : 1)}}">
                  <image wx:if="{{cloth.img}}" class="c-img" src="{{cloth.img}}" mode="aspectFill"></image>
                  <view wx:else class="c-img c-placeholder">
                    <text class="c-placeholder-text">{{cloth.type}}</text>
                  </view>
                  <view class="c-label">{{cloth.type}}</view>
                </view>
              </block>
            </view>

            <view class="reason-area flex-col">
              <text class="r-text text-body">“{{item.reason}}”</text>
              <view class="alt-tip flex-row items-center mt-md" wx:if="{{item.alternative}}">
                <text class="tip-icon">💡</text>
                <text class="text-caption text-tertiary ml-sm">{{item.alternative.msg}}</text>
              </view>
              <button
                class="btn-primary canvas-sync-btn"
                bindtap="syncCurrentLookToCanvas"
                loading="{{syncingToCanvas}}"
              >
                同步到画布继续编辑
              </button>
            </view>

            <view class="feedback-bar flex-row justify-between items-center mt-auto">
              <view class="fb-btn btn-dislike" bindtap="onAction" data-action="dislike">不合适</view>
              <view class="fb-icons flex-row">
                <view class="icon-btn" bindtap="onAction" data-action="save">★</view>
                <view class="icon-btn" bindtap="onAction" data-action="like">❤</view>
              </view>
            </view>
          </view>
        </swiper-item>
      </block>
    </swiper>

    <view class="swiper-dots flex-row justify-center mt-lg">
      <block wx:for="{{looks}}" wx:key="id">
        <view class="dot {{currentSwipe === index ? 'active' : ''}}"></view>
      </block>
    </view>
  </block>
</view>
