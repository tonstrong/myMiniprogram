.saved-page {
  padding-bottom: 48rpx;
}

.page-head {
  margin-top: var(--spacing-md);
}

.page-copy {
  flex: 1;
}

.page-subtitle {
  display: block;
  margin-top: 12rpx;
  line-height: 1.7;
  max-width: 420rpx;
}

.page-head-btn {
  padding: 16rpx 28rpx;
  min-height: auto;
  line-height: 1.4;
  font-size: 26rpx;
  flex-shrink: 0;
}

.page-count {
  display: block;
  margin-top: var(--spacing-md);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.cards-wrap {
  margin-top: 28rpx;
}

.cards-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
}

.outfit-card {
  background: #ffffff;
  border-radius: 28rpx;
  overflow: hidden;
  box-shadow: 0 12rpx 32rpx rgba(15, 23, 42, 0.08);
  border: 1rpx solid rgba(15, 23, 42, 0.04);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.outfit-card:active {
  transform: scale(0.985);
  box-shadow: 0 8rpx 24rpx rgba(15, 23, 42, 0.1);
}

.canvas-board {
  position: relative;
  height: 360rpx;
  margin: 14rpx;
  border-radius: 22rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(247, 247, 245, 0.98) 100%),
    radial-gradient(circle at top left, rgba(212, 163, 115, 0.12), transparent 40%);
  overflow: hidden;
}

.canvas-piece,
.canvas-fallback-piece,
.canvas-fallback {
  position: absolute;
}

.canvas-piece,
.canvas-fallback {
  background: transparent;
}

.piece-top {
  top: 26rpx;
  left: 84rpx;
  width: 166rpx;
  height: 120rpx;
}

.piece-bottom {
  top: 126rpx;
  left: 90rpx;
  width: 156rpx;
  height: 188rpx;
}

.piece-dress {
  top: 20rpx;
  left: 74rpx;
  width: 176rpx;
  height: 264rpx;
}

.piece-outer {
  top: 14rpx;
  left: 16rpx;
  width: 120rpx;
  height: 168rpx;
}

.piece-bag {
  left: 18rpx;
  bottom: 56rpx;
  width: 92rpx;
  height: 92rpx;
}

.piece-shoes-left {
  left: 116rpx;
  bottom: 18rpx;
  width: 70rpx;
  height: 54rpx;
}

.piece-shoes-right {
  right: 18rpx;
  bottom: 18rpx;
  width: 70rpx;
  height: 54rpx;
}

.piece-accessory {
  width: 44rpx;
  height: 44rpx;
  right: 18rpx;
}

.piece-accessory-0 {
  top: 18rpx;
}

.piece-accessory-1 {
  top: 68rpx;
}

.piece-accessory-2 {
  top: 118rpx;
}

.piece-generic {
  top: 76rpx;
  left: 86rpx;
  width: 150rpx;
  height: 150rpx;
}

.canvas-fallback-piece {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #eef2f7 0%, #d8e1ea 100%);
  border-radius: 18rpx;
  padding: 12rpx;
  text-align: center;
}

.fallback-piece-text {
  font-size: 20rpx;
  color: rgba(28, 28, 30, 0.62);
  line-height: 1.4;
}

.canvas-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
}

.canvas-empty-text {
  font-size: 24rpx;
  color: var(--text-tertiary);
}

.canvas-fallback {
  inset: 24rpx;
}

.card-body {
  padding: 4rpx 18rpx 20rpx;
}

.card-top,
.card-bottom {
  gap: var(--spacing-sm);
}

.card-actions {
  gap: 12rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.card-time {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.card-date,
.card-count {
  display: block;
  font-size: 24rpx;
  color: var(--text-secondary);
}

.delete-btn {
  min-height: auto;
  line-height: 1.2;
  padding: 8rpx 16rpx;
  margin: 0;
  border-radius: 999rpx;
  border: none;
  background: rgba(28, 28, 30, 0.06);
  color: var(--text-secondary);
  font-size: 20rpx;
}

.delete-btn::after {
  border: none;
}

.empty-state {
  min-height: 520rpx;
  margin-top: var(--spacing-md);
  padding: 48rpx 32rpx;
  text-align: center;
}

.empty-title {
  margin-top: var(--spacing-md);
}

.empty-copy {
  margin-top: 12rpx;
  line-height: 1.7;
}

.empty-btn {
  margin-top: var(--spacing-lg);
}

.list-status {
  width: 100%;
  text-align: center;
  padding: 24rpx 0 40rpx;
  font-size: 24rpx;
}

.loading-text {
  color: var(--text-secondary);
}

.done-text {
  color: var(--text-tertiary);
}
