.home-page {
  padding-bottom: 160rpx;
  background:
    radial-gradient(circle at top right, rgba(212, 163, 115, 0.14), transparent 32%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(247, 244, 239, 0.98) 100%);
}

.nav-space {
  height: 180rpx;
}

.header-section {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: var(--spacing-xl);
}

.greeting-date {
  text-transform: uppercase;
  letter-spacing: 2rpx;
  margin-bottom: var(--spacing-xs);
}

.subtitle {
  color: var(--text-secondary);
  margin-top: var(--spacing-xs);
}

.avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: var(--radius-max);
  overflow: hidden;
  box-shadow: var(--shadow-sm);
  border: 4rpx solid #fff;
}

.avatar-img {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #1c1c1e 0%, #4b5563 100%);
  color: #fff;
  font-size: 40rpx;
  font-weight: 600;
}

.task-section {
  margin-bottom: var(--spacing-xl);
}

.task-card {
  padding: var(--spacing-md) var(--spacing-lg);
  margin-bottom: var(--spacing-sm);
}

.task-main {
  flex: 1;
  min-width: 0;
}

.task-copy {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.task-title {
  line-height: 1.4;
}

.task-detail-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 8rpx;
}

.task-detail {
  max-width: 420rpx;
  color: var(--text-secondary);
  font-size: 24rpx;
  line-height: 1.5;
}

.task-more {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(212, 163, 115, 0.12);
  color: var(--brand-primary);
  font-size: 22rpx;
}

.task-icon {
  width: 16rpx;
  height: 16rpx;
  border-radius: var(--radius-max);
  margin-right: var(--spacing-md);
}

.task-icon.upload {
  background-color: var(--status-warning);
}

.task-icon.style {
  background-color: var(--brand-pop);
}

.btn-action {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  border-radius: var(--radius-max);
  background: var(--brand-primary);
  color: #fff;
  margin: 0;
}

.recommend-section {
  margin-bottom: var(--spacing-xl);
}

.section-header {
  margin-bottom: var(--spacing-md);
}

.recommend-card {
  position: relative;
  width: 100%;
  min-height: 600rpx;
  border-radius: 40rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 48rpx rgba(28, 28, 30, 0.14);
}

.rc-bg {
  position: absolute;
  inset: 0;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.rc-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background:
    radial-gradient(circle at 20% 18%, rgba(255, 255, 255, 0.45), transparent 18%),
    linear-gradient(135deg, #2f3b52 0%, #7c5f45 100%);
}

.rc-placeholder-text {
  color: rgba(255, 255, 255, 0.92);
  font-size: 48rpx;
  font-weight: 600;
  letter-spacing: 8rpx;
}

.rc-overlay {
  position: relative;
  z-index: 2;
  min-height: 600rpx;
  height: 100%;
  padding: var(--spacing-lg);
  background: linear-gradient(to bottom, rgba(15, 23, 42, 0.12) 0%, rgba(15, 23, 42, 0.7) 100%);
}

.blur-tag {
  margin-right: var(--spacing-sm);
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(12px);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.28);
}

.rc-bottom {
  display: flex;
  flex-direction: column;
  gap: var(--spacing-lg);
}

.rc-reason {
  display: block;
  color: #fff;
  line-height: 1.45;
}

.rc-actions {
  display: flex;
  justify-content: center;
  align-items: center;
}

.rc-btn {
  width: 100%;
  min-height: auto;
  line-height: 1.4;
  padding: 18rpx 20rpx;
  border-radius: var(--radius-max);
  font-size: 26rpx;
  border: none;
}

.rc-btn-primary {
  background: rgba(255, 255, 255, 0.96);
  color: var(--brand-primary);
}

.rc-btn-secondary {
  background: rgba(255, 255, 255, 0.16);
  color: #fff;
  border: 1px solid rgba(255, 255, 255, 0.26);
}

.rc-btn-centered {
  width: auto;
  min-width: 260rpx;
  padding: 18rpx 40rpx;
  box-shadow: 0 14rpx 28rpx rgba(15, 23, 42, 0.14);
  backdrop-filter: blur(10px);
}

.stats-inline {
  margin-bottom: var(--spacing-lg);
  padding: 0 8rpx;
}

.action-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: var(--spacing-md);
}

.action-item {
  position: relative;
  overflow: hidden;
  min-height: 260rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  align-items: flex-start;
  padding: var(--spacing-lg);
}

.action-item::after {
  content: '';
  position: absolute;
  right: -20rpx;
  bottom: -30rpx;
  width: 140rpx;
  height: 140rpx;
  border-radius: 999rpx;
  opacity: 0.3;
}

.action-item.upload::after {
  background: linear-gradient(135deg, #ffd89b 0%, #f9b35c 100%);
}

.action-item.style::after {
  background: linear-gradient(135deg, #bde7ff 0%, #6da7ff 100%);
}

.action-item.canvas::after {
  background: linear-gradient(135deg, #ffd6e6 0%, #ff8db3 100%);
}

.action-item:active {
  transform: scale(0.98);
}

.action-icon-badge {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 72rpx;
  border-radius: 24rpx;
  font-size: 40rpx;
  box-shadow: 0 12rpx 24rpx rgba(28, 28, 30, 0.08);
}

.upload-badge {
  background: linear-gradient(135deg, #fff2cf 0%, #ffd17a 100%);
}

.style-badge {
  background: linear-gradient(135deg, #e4f4ff 0%, #97c2ff 100%);
}

.canvas-badge {
  background: linear-gradient(135deg, #ffe5ef 0%, #ffadc8 100%);
}

.action-title {
  margin-top: var(--spacing-md);
  margin-bottom: 6rpx;
}
