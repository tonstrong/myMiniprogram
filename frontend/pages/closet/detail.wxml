<scroll-view class="container no-pad" scroll-y>
  <view class="hero-image-wrap">
    <image wx:if="{{item.img}}" class="hero-img" src="{{item.img}}" mode="aspectFill"></image>
    <view wx:else class="hero-placeholder">
      <text class="hero-placeholder-text">单品图片</text>
    </view>
    <view class="hero-gradient"></view>
  </view>

  <view class="form-panel glass-panel animate-fade-in">
    <view class="form-header">
      <view class="flex-row items-center justify-between">
        <text class="text-h2">{{isNew ? '单品识别与确认' : '单品特征'}}</text>
        <view class="tool-actions">
        <button class="btn-secondary mini-ai-btn" bindtap="triggerAiExtract" loading="{{aiExtracting}}">
          {{aiExtracting ? '识别中' : 'AI识别'}}
        </button>
        <button class="btn-secondary mini-ai-btn cutout-btn" bindtap="triggerCutoutPreview" loading="{{cutoutProcessing}}">
          {{cutoutProcessing ? '抠图中' : '智能抠图'}}
        </button>
        </view>
      </view>
    </view>

    <view class="form-list">
      <picker mode="selector" range="{{CATEGORY_OPTIONS}}" bindchange="bindCategoryChange">
        <view class="f-row flex-row items-center justify-between">
          <text class="f-label">类别</text>
          <view class="flex-row items-center">
            <text class="f-value">{{item.category || '点击选择'}}</text>
            <text class="arrow">></text>
          </view>
        </view>
      </picker>

      <view class="f-row flex-row items-center justify-between" bindtap="editField" data-field="子类">
        <text class="f-label">子类</text>
        <view class="flex-row items-center">
          <text class="f-value">{{item.subCategory || '点击补充'}}</text>
          <text class="arrow">></text>
        </view>
      </view>

      <picker mode="selector" range="{{FIT_OPTIONS}}" bindchange="bindFitChange">
        <view class="f-row flex-row items-center justify-between">
          <text class="f-label">版型</text>
          <view class="flex-row items-center">
            <text class="f-value">{{item.fit || '点击选择'}}</text>
            <text class="arrow">></text>
          </view>
        </view>
      </picker>

      <view class="f-row col-mode">
        <view class="flex-row items-center justify-between w-full h-auto">
          <text class="f-label">颜色仪表盘</text>
          <view class="flex-row items-center">
            <text class="f-value">{{item.colors.length}} 已选</text>
            <text class="arrow" bindtap="editField" data-field="颜色">+</text>
          </view>
        </view>
        <view class="color-palette">
          <block wx:for="{{COLOR_PALETTE}}" wx:key="label" wx:for-item="colorOption">
            <view class="color-chip {{colorOption.selected ? 'active' : ''}}" bindtap="toggleColor" data-color="{{colorOption.label}}">
              <view class="color-swatch" style="{{colorOption.swatchStyle}}"></view>
              <text class="color-chip-text">{{colorOption.label}}</text>
            </view>
          </block>
          <view class="color-chip add-color-chip" bindtap="editField" data-field="颜色">
            <text class="color-chip-plus">+</text>
            <text class="color-chip-text">自定义</text>
          </view>
        </view>
        <view class="tag-row flex-row mt-2" wx:if="{{item.colors.length > 0}}">
          <block wx:for="{{item.colors}}" wx:key="*this">
            <view class="tag-chip active removable-chip" catchtap="removeColor" data-color="{{item}}">
              {{item}} ×
            </view>
          </block>
        </view>
      </view>

      <view class="f-row col-mode" bindtap="editField" data-field="季节">
        <view class="flex-row items-center justify-between w-full h-auto">
          <text class="f-label">适用季节</text>
          <text class="arrow">></text>
        </view>
        <view class="tag-row flex-row mt-2">
          <block wx:for="{{item.seasons}}" wx:key="*this">
            <view class="tag-chip active">{{item}}</view>
          </block>
        </view>
      </view>

      <view class="f-row col-mode" bindtap="editField" data-field="风格">
        <view class="flex-row items-center justify-between w-full h-auto">
          <text class="f-label">AI 提纯风格</text>
          <text class="arrow">></text>
        </view>
        <view class="tag-row flex-row mt-2">
          <block wx:for="{{item.tags}}" wx:key="*this">
            <view class="tag-chip active">{{item}}</view>
          </block>
          <view class="tag-chip" catchtap="addCustomTag">+ 添加</view>
        </view>
      </view>
    </view>

    <view class="action-bar mt-4 {{isNew ? 'single' : 'double'}}">
      <block wx:if="{{isNew}}">
        <button class="btn-primary action-btn" bindtap="confirmItem">确认并入库</button>
      </block>
      <block wx:else>
        <button class="btn-primary action-btn" bindtap="confirmItem">{{requiresConfirmation ? '保存并确认' : '保存修改'}}</button>
        <button class="btn-secondary action-btn text-error" bindtap="deleteItem">删除单品</button>
      </block>
    </view>
  </view>
</scroll-view>

<view wx:if="{{inputSheet.visible}}" class="editor-sheet-mask" bindtap="closeInputSheet">
  <view class="editor-sheet-panel" catchtap="noop">
    <view class="editor-sheet-header">
      <text class="editor-sheet-title">{{inputSheet.title}}</text>
      <text class="editor-sheet-close" bindtap="closeInputSheet">×</text>
    </view>
    <text class="editor-sheet-copy">用更细的描述补充单品信息，搭配和检索都会更准确。</text>
    <input
      class="editor-sheet-input"
      placeholder="{{inputSheet.placeholder}}"
      placeholder-class="editor-sheet-placeholder"
      value="{{inputSheet.value}}"
      focus
      maxlength="24"
      bindinput="onInputSheetChange"
      confirm-type="done"
      bindconfirm="submitInputSheet"
    />
    <view class="editor-sheet-actions">
      <button class="btn-secondary editor-sheet-btn" bindtap="closeInputSheet">取消</button>
      <button class="btn-primary editor-sheet-btn" bindtap="submitInputSheet">{{inputSheet.confirmText}}</button>
    </view>
  </view>
</view>

<view wx:if="{{cutoutPreview.visible}}" class="editor-sheet-mask" bindtap="closeCutoutPreview">
  <view class="editor-sheet-panel cutout-sheet-panel" catchtap="noop">
    <view class="editor-sheet-header">
      <text class="editor-sheet-title">智能抠图预览</text>
      <text class="editor-sheet-close" bindtap="closeCutoutPreview">×</text>
    </view>
    <text class="editor-sheet-copy">已为你提取衣物主体。确认后会替换当前单品图片，用于画布搭配与展示。</text>
    <view class="cutout-preview-wrap">
      <image class="cutout-preview-image" src="{{cutoutPreview.imagePath}}" mode="aspectFit"></image>
    </view>
    <view class="cutout-meta">
      <text class="cutout-meta-text">引擎：{{cutoutPreview.engineUsed || 'auto'}}</text>
    </view>
    <view class="editor-sheet-actions">
      <button class="btn-secondary editor-sheet-btn" bindtap="closeCutoutPreview">保留原图</button>
      <button class="btn-primary editor-sheet-btn" bindtap="confirmCutoutPreview" loading="{{cutoutProcessing}}">使用这张</button>
    </view>
  </view>
</view>
