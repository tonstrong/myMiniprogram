.no-pad {
  padding: 0;
  background-color: #FFFFFF;
}

.hero-image-wrap {
  width: 100%;
  height: 900rpx;
  position: relative;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.hero-placeholder {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e5e7eb 0%, #d1d5db 100%);
}

.hero-placeholder-text {
  color: rgba(28, 28, 30, 0.55);
  font-size: 40rpx;
  font-weight: 600;
}

.hero-gradient {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 100%;
  height: 200rpx;
  background: linear-gradient(to bottom, rgba(255,255,255,0) 0%, rgba(255,255,255,1) 100%);
}

.form-panel {
  position: relative;
  z-index: 10;
  margin-top: -60rpx;
  padding: var(--spacing-xl) var(--spacing-lg) 120rpx;
  background: var(--color-bg-primary);
  border-radius: 48rpx 48rpx 0 0;
  min-height: 50vh;
}

.form-header {
  margin-bottom: var(--spacing-xl);
}

.tool-actions {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.mini-ai-btn {
  min-height: auto;
  margin: 0;
  padding: 14rpx 28rpx;
  line-height: 1.2;
  font-size: 24rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
  color: #3f3125;
  background: linear-gradient(135deg, rgba(255, 248, 238, 0.98) 0%, rgba(243, 228, 205, 0.96) 100%);
  border: 1rpx solid rgba(178, 141, 92, 0.28);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 24rpx rgba(122, 82, 48, 0.12);
}

.cutout-btn {
  background: linear-gradient(135deg, rgba(247, 247, 242, 0.98) 0%, rgba(224, 238, 228, 0.96) 100%);
  color: #2f5540;
  border-color: rgba(95, 141, 78, 0.24);
}

.form-list {
  display: flex;
  flex-direction: column;
}

.f-row {
  padding: var(--spacing-lg) 0;
  border-bottom: 1rpx solid rgba(0,0,0,0.05);
}
.f-row:last-child {
  border-bottom: none;
}

.col-mode {
  flex-direction: column;
  align-items: flex-start;
}

.w-full { width: 100%; }
.mt-2 { margin-top: var(--spacing-md); }
.mt-3 { margin-top: var(--spacing-lg); }
.mt-4 { margin-top: var(--spacing-xl); }

.f-label {
  font-size: 30rpx;
  color: var(--text-main);
  font-weight: 500;
}

.f-value {
  font-size: 30rpx;
  color: var(--brand-accent);
  margin-right: var(--spacing-sm);
}

.arrow {
  color: var(--text-tertiary);
  font-family: monospace;
}

.color-dot {
  width: 24rpx;
  height: 24rpx;
  border-radius: var(--radius-max);
  margin-right: var(--spacing-sm);
}

.color-palette {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-top: var(--spacing-md);
}

.color-chip {
  min-width: 132rpx;
  padding: 14rpx 16rpx;
  border-radius: 22rpx;
  background: rgba(28, 28, 30, 0.04);
  display: flex;
  align-items: center;
  justify-content: flex-start;
  gap: 12rpx;
  border: 1rpx solid transparent;
}

.color-chip.active {
  background: rgba(28, 28, 30, 0.08);
  border-color: rgba(28, 28, 30, 0.12);
}

.color-swatch {
  width: 24rpx;
  height: 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(0, 0, 0, 0.08);
  flex-shrink: 0;
}

.color-chip-text {
  font-size: 24rpx;
  color: var(--text-main);
}

.add-color-chip {
  justify-content: center;
}

.color-chip-plus {
  font-size: 28rpx;
  color: var(--brand-accent);
}

.removable-chip {
  padding-right: 18rpx;
}

.tag-row {
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.text-error {
  color: var(--status-error) !important;
  background: rgba(255, 59, 48, 0.05) !important;
}

.action-bar {
  margin-top: 64rpx;
  display: flex;
  gap: 20rpx;
}

.action-bar.single {
  flex-direction: column;
}

.action-bar.double {
  flex-direction: row;
}

.action-btn {
  flex: 1;
  width: auto;
  min-width: 0;
  margin: 0;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.4;
  box-sizing: border-box;
}

.action-bar .btn-secondary {
  display: flex;
  justify-content: center;
  align-items: center;
}

.action-bar .text-error {
  border: 1rpx solid rgba(255, 59, 48, 0.12);
}

.editor-sheet-mask {
  position: fixed;
  inset: 0;
  z-index: 90;
  display: flex;
  align-items: flex-end;
  justify-content: center;
  background: rgba(15, 23, 42, 0.22);
  backdrop-filter: blur(10rpx);
}

.editor-sheet-panel {
  width: 100%;
  padding: 36rpx 32rpx calc(44rpx + env(safe-area-inset-bottom));
  border-radius: 40rpx 40rpx 0 0;
  background:
    radial-gradient(circle at top right, rgba(212, 163, 115, 0.14), transparent 30%),
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(248, 244, 238, 0.98) 100%);
  box-shadow: 0 -18rpx 48rpx rgba(15, 23, 42, 0.14);
}

.editor-sheet-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.editor-sheet-title {
  color: #2f241a;
  font-size: 38rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.editor-sheet-close {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: rgba(47, 36, 26, 0.7);
  background: rgba(255, 255, 255, 0.62);
  font-size: 36rpx;
}

.editor-sheet-copy {
  display: block;
  margin-top: 14rpx;
  color: rgba(47, 36, 26, 0.66);
  font-size: 25rpx;
  line-height: 1.7;
}

.editor-sheet-input {
  width: 100%;
  margin-top: 28rpx;
  padding: 24rpx 26rpx;
  border-radius: 26rpx;
  background: rgba(255, 255, 255, 0.86);
  border: 1rpx solid rgba(181, 145, 98, 0.26);
  box-shadow: inset 0 1rpx 0 rgba(255, 255, 255, 0.75);
  color: #2f241a;
  font-size: 31rpx;
  line-height: 1.4;
}

.editor-sheet-placeholder {
  color: rgba(94, 78, 60, 0.44);
  font-size: 30rpx;
}

.editor-sheet-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 30rpx;
}

.editor-sheet-btn {
  flex: 1;
  margin: 0;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.4;
  border-radius: 999rpx;
}

.cutout-sheet-panel {
  max-height: 82vh;
}

.cutout-preview-wrap {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 28rpx;
  background:
    linear-gradient(45deg, rgba(15, 23, 42, 0.035) 25%, transparent 25%) 0 0 / 24rpx 24rpx,
    linear-gradient(-45deg, rgba(15, 23, 42, 0.035) 25%, transparent 25%) 0 12rpx / 24rpx 24rpx,
    linear-gradient(45deg, transparent 75%, rgba(15, 23, 42, 0.035) 75%) 12rpx -12rpx / 24rpx 24rpx,
    linear-gradient(-45deg, transparent 75%, rgba(15, 23, 42, 0.035) 75%) -12rpx 0 / 24rpx 24rpx,
    rgba(255, 255, 255, 0.88);
  border: 1rpx solid rgba(181, 145, 98, 0.18);
}

.cutout-preview-image {
  width: 100%;
  height: 520rpx;
}

.cutout-meta {
  margin-top: 18rpx;
}

.cutout-meta-text {
  display: block;
  color: rgba(47, 36, 26, 0.62);
  font-size: 24rpx;
}
