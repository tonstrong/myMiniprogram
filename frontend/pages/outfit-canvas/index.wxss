.canvas-page {
  padding-bottom: 80rpx;
}

.canvas-header {
  margin-bottom: var(--spacing-lg);
}

.canvas-board {
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
}

.board-actions {
  margin-bottom: var(--spacing-lg);
}

.board-buttons {
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.canvas-mini-btn {
  min-height: auto;
  line-height: 1.4;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
}

.saved-hint {
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: rgba(101, 116, 137, 0.08);
  gap: var(--spacing-md);
}

.saved-hint-copy {
  flex: 1;
}

.saved-hint-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.saved-hint-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.saved-hint-btn {
  min-height: auto;
  line-height: 1.4;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.slot-section {
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: rgba(28, 28, 30, 0.03);
  margin-bottom: var(--spacing-md);
  border: 2rpx solid transparent;
}

.slot-section.active {
  border-color: var(--brand-primary);
  background: rgba(28, 28, 30, 0.06);
}

.slot-header {
  margin-bottom: var(--spacing-sm);
}

.slot-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text-main);
}

.slot-tip {
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.slot-card,
.accessory-row {
  min-height: 180rpx;
}

.slot-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 150rpx;
  color: var(--text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

.placed-card {
  display: flex;
  align-items: center;
  gap: var(--spacing-md);
  background: rgba(255,255,255,0.9);
  border-radius: var(--radius-md);
  padding: var(--spacing-sm);
}

.placed-image {
  width: 120rpx;
  height: 120rpx;
  border-radius: var(--radius-sm);
}

.placed-meta {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.placed-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.placed-remove {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-tertiary);
}

.accessory-row {
  display: flex;
  flex-wrap: wrap;
  gap: var(--spacing-sm);
}

.mini-card {
  width: 140rpx;
}

.mini-card-img {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--radius-sm);
}

.mini-card-text {
  display: block;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
  text-align: center;
}

.mini-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e5e7eb 0%, #cbd5e1 100%);
  color: rgba(28, 28, 30, 0.55);
  font-size: 24rpx;
  font-weight: 600;
}

.tray-section {
  margin-bottom: var(--spacing-lg);
}

.tray-header {
  margin-bottom: var(--spacing-md);
}

.tray-empty {
  padding: var(--spacing-lg);
  text-align: center;
  color: var(--text-secondary);
}

.tray-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--spacing-md);
}

.tray-card {
  overflow: hidden;
}

.tray-image {
  width: 100%;
  height: 220rpx;
}

.tray-meta {
  padding: var(--spacing-sm);
}

.tray-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.tray-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}
