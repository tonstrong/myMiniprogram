.canvas-page-shell {
  min-height: 100vh;
  overflow-x: hidden;
  background: var(--color-bg-primary);
}

.canvas-page {
  width: 100%;
  overflow-x: hidden;
  padding-bottom: calc(120rpx + env(safe-area-inset-bottom));
}

.canvas-header {
  margin-bottom: var(--spacing-lg);
}

.canvas-shell {
  width: 100%;
  overflow: hidden;
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
}

.board-summary {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
}

.board-copy {
  min-width: 0;
  flex: 1;
}

.board-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.board-meter {
  flex-shrink: 0;
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 30, 0.06);
  font-size: 24rpx;
  color: var(--text-secondary);
}

.saved-hint {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: rgba(101, 116, 137, 0.08);
}

.saved-hint-copy {
  min-width: 0;
}

.saved-hint-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.saved-hint-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.saved-hint-btn {
  width: 100%;
  min-height: auto;
  line-height: 1.4;
  padding: 16rpx 24rpx;
  font-size: 24rpx;
}

.free-canvas-stage {
  width: 100%;
  height: 980rpx;
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 244, 241, 0.98) 100%);
  border: 1rpx solid rgba(15, 23, 42, 0.04);
}

.free-canvas-stage::before,
.free-canvas-stage::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.free-canvas-stage::before {
  background-image:
    linear-gradient(rgba(15, 23, 42, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1rpx, transparent 1rpx);
  background-size: 56rpx 56rpx;
}

.free-canvas-stage::after {
  background: radial-gradient(circle at top left, rgba(212, 163, 115, 0.12), transparent 42%);
}

.stage-empty {
  position: absolute;
  inset: 0;
  z-index: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 80rpx;
}

.stage-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.stage-empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.stage-empty-btn {
  margin-top: 28rpx;
  min-width: 260rpx;
}

.canvas-piece {
  box-sizing: border-box;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  background: transparent;
}

.canvas-piece.selected {
  border-color: rgba(28, 28, 30, 0.26);
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.12);
}

.canvas-piece-image {
  width: 100%;
  height: 100%;
}

.piece-label {
  position: absolute;
  left: 8rpx;
  right: 44rpx;
  bottom: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 30, 0.74);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.resize-handle {
  position: absolute;
  right: 8rpx;
  bottom: 8rpx;
  width: 34rpx;
  height: 34rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 30, 0.82);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 16rpx rgba(15, 23, 42, 0.16);
}

.resize-handle.active {
  transform: scale(1.08);
}

.resize-handle.hidden {
  opacity: 0;
}

.resize-handle-icon {
  font-size: 20rpx;
  color: #fff;
  line-height: 1;
}

.selected-bar {
  margin-top: var(--spacing-md);
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background: rgba(28, 28, 30, 0.04);
}

.selected-text {
  font-size: 24rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.selected-state {
  display: block;
  margin-top: 10rpx;
  font-size: 22rpx;
  color: var(--brand-accent);
}

.selected-tools {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12rpx;
  margin-top: 16rpx;
}

.tool-btn {
  width: 100%;
  min-height: auto;
  line-height: 1.4;
  padding: 14rpx 16rpx;
  font-size: 24rpx;
}

.canvas-actions {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--spacing-sm);
  margin-top: var(--spacing-lg);
}

.canvas-action-btn {
  width: 100%;
  min-height: auto;
  line-height: 1.4;
  padding: 18rpx 20rpx;
  font-size: 26rpx;
}

.picker-mask {
  position: fixed;
  inset: 0;
  z-index: 40;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 23, 42, 0.34);
}

.picker-panel {
  width: 100%;
  max-height: 78vh;
  padding: var(--spacing-lg) var(--spacing-lg) calc(32rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: rgba(255, 255, 255, 0.98);
  box-shadow: 0 -20rpx 48rpx rgba(15, 23, 42, 0.12);
}

.picker-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: var(--spacing-md);
  margin-bottom: var(--spacing-md);
}

.picker-copy {
  min-width: 0;
  flex: 1;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.picker-close-btn {
  flex-shrink: 0;
  min-height: auto;
  line-height: 1.4;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
}

.picker-scroll {
  height: 58vh;
}

.tray-empty {
  padding: var(--spacing-lg);
  text-align: center;
  color: var(--text-secondary);
}

.tray-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--spacing-md);
}

.tray-card {
  overflow: hidden;
  border: 1rpx solid transparent;
}

.tray-card-active {
  border-color: rgba(28, 28, 30, 0.12);
  background: rgba(255, 255, 255, 0.96);
}

.tray-image {
  width: 100%;
  height: 220rpx;
}

.tray-meta {
  padding: var(--spacing-sm);
}

.tray-title {
  flex: 1;
  min-width: 0;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.tray-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.tray-badge {
  margin-left: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 30, 0.08);
  font-size: 20rpx;
  color: var(--text-secondary);
  flex-shrink: 0;
}

.mini-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e5e7eb 0%, #cbd5e1 100%);
  color: rgba(28, 28, 30, 0.55);
  font-size: 24rpx;
  font-weight: 600;
}
