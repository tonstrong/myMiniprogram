.canvas-page {
  padding-bottom: 80rpx;
}

.canvas-header {
  margin-bottom: var(--spacing-lg);
}

.canvas-shell {
  padding: var(--spacing-lg);
  margin-bottom: var(--spacing-lg);
}

.board-summary {
  margin-bottom: var(--spacing-lg);
  gap: var(--spacing-md);
}

.board-copy {
  flex: 1;
}

.board-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--text-main);
}

.board-buttons {
  gap: 16rpx;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.canvas-mini-btn {
  min-height: auto;
  line-height: 1.4;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
}

.saved-hint {
  margin-bottom: var(--spacing-lg);
  padding: var(--spacing-md);
  border-radius: var(--radius-md);
  background: rgba(101, 116, 137, 0.08);
  gap: var(--spacing-md);
}

.saved-hint-copy {
  flex: 1;
}

.saved-hint-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
}

.saved-hint-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.6;
  color: var(--text-secondary);
}

.saved-hint-btn {
  min-height: auto;
  line-height: 1.4;
  padding: 14rpx 24rpx;
  font-size: 24rpx;
  flex-shrink: 0;
}

.free-canvas-stage {
  width: 100%;
  height: 980rpx;
  position: relative;
  overflow: hidden;
  border-radius: 28rpx;
  background:
    linear-gradient(180deg, rgba(255, 255, 255, 0.98) 0%, rgba(244, 244, 241, 0.98) 100%);
  border: 1rpx solid rgba(15, 23, 42, 0.04);
}

.free-canvas-stage::before,
.free-canvas-stage::after {
  content: '';
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.free-canvas-stage::before {
  background-image:
    linear-gradient(rgba(15, 23, 42, 0.035) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(15, 23, 42, 0.035) 1rpx, transparent 1rpx);
  background-size: 56rpx 56rpx;
}

.free-canvas-stage::after {
  background: radial-gradient(circle at top left, rgba(212, 163, 115, 0.12), transparent 42%);
}

.stage-empty {
  position: absolute;
  inset: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 0 80rpx;
  z-index: 1;
}

.stage-empty-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-main);
}

.stage-empty-desc {
  margin-top: 12rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: var(--text-secondary);
}

.canvas-piece {
  box-sizing: border-box;
  border: 2rpx solid transparent;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.7);
}

.canvas-piece.selected {
  border-color: rgba(28, 28, 30, 0.26);
  box-shadow: 0 12rpx 24rpx rgba(15, 23, 42, 0.12);
}

.canvas-piece-image {
  width: 100%;
  height: 100%;
}

.piece-label {
  position: absolute;
  left: 8rpx;
  right: 8rpx;
  bottom: 8rpx;
  padding: 8rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 30, 0.74);
  color: #fff;
  font-size: 20rpx;
  text-align: center;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.selected-bar {
  margin-top: var(--spacing-md);
  padding: 18rpx 20rpx;
  border-radius: var(--radius-md);
  background: rgba(28, 28, 30, 0.04);
}

.selected-text {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.tray-section {
  margin-bottom: var(--spacing-lg);
}

.tray-header {
  margin-bottom: var(--spacing-md);
  gap: var(--spacing-md);
}

.tray-copy {
  flex: 1;
}

.tray-count {
  font-size: 24rpx;
  color: var(--text-secondary);
}

.tray-empty {
  padding: var(--spacing-lg);
  text-align: center;
  color: var(--text-secondary);
}

.tray-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: var(--spacing-md);
}

.tray-card {
  overflow: hidden;
  border: 1rpx solid transparent;
}

.tray-card-active {
  border-color: rgba(28, 28, 30, 0.12);
  background: rgba(255, 255, 255, 0.96);
}

.tray-image {
  width: 100%;
  height: 220rpx;
}

.tray-meta {
  padding: var(--spacing-sm);
}

.tray-title {
  font-size: 26rpx;
  font-weight: 600;
  color: var(--text-main);
  flex: 1;
}

.tray-sub {
  display: block;
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-secondary);
}

.tray-badge {
  margin-left: 12rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: rgba(28, 28, 30, 0.08);
  font-size: 20rpx;
  color: var(--text-secondary);
}

.mini-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e5e7eb 0%, #cbd5e1 100%);
  color: rgba(28, 28, 30, 0.55);
  font-size: 24rpx;
  font-weight: 600;
}
