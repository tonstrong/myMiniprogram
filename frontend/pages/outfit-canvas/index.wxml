<scroll-view class="container canvas-page" scroll-y>
  <view class="canvas-header animate-fade-in">
    <text class="text-h2">自由搭配画布</text>
    <text class="text-caption">先从下方衣橱加入单品，再在画布里拖拽摆放。最多 {{maxCanvasItems}} 件。</text>
  </view>

  <view class="canvas-shell glass-panel animate-fade-in" style="animation-delay: 0.05s;">
    <view class="board-summary flex-row justify-between items-center">
      <view class="flex-col board-copy">
        <text class="board-title">搭配区</text>
        <text class="text-caption">已放入 {{canvasItems.length}} / {{maxCanvasItems}} 件</text>
      </view>
      <view class="flex-row board-buttons">
        <button class="btn-secondary canvas-mini-btn" bindtap="removeSelectedItem" disabled="{{!selectedCanvasItemId}}">删选中</button>
        <button class="btn-secondary canvas-mini-btn" bindtap="clearCanvas">清空</button>
        <button class="btn-primary canvas-mini-btn" bindtap="saveCanvasDraft">存草稿</button>
        <button class="btn-primary canvas-mini-btn" bindtap="saveCanvasRecord" loading="{{savingRemote}}">保存搭配</button>
      </view>
    </view>

    <view wx:if="{{lastSavedOutfitId}}" class="saved-hint flex-row items-center justify-between">
      <view class="flex-col saved-hint-copy">
        <text class="saved-hint-title">最近这套搭配已经入库</text>
        <text class="saved-hint-desc">可以去“我的搭配”里统一查看已保存的自由画布搭配</text>
      </view>
      <button class="btn-secondary saved-hint-btn" bindtap="openSavedOutfits">查看我的搭配</button>
    </view>

    <movable-area id="free-canvas-stage" class="free-canvas-stage">
      <view wx:if="{{canvasItems.length === 0}}" class="stage-empty">
        <text class="stage-empty-title">画布还是空的</text>
        <text class="stage-empty-desc">从下方衣橱点选单品加入，然后直接拖拽摆放位置</text>
      </view>

      <block wx:for="{{canvasItems}}" wx:key="id">
        <movable-view
          class="canvas-piece {{selectedCanvasItemId === item.id ? 'selected' : ''}}"
          data-id="{{item.id}}"
          x="{{item.xPx}}"
          y="{{item.yPx}}"
          direction="all"
          inertia="{{false}}"
          bindtap="selectCanvasItem"
          bindchange="onPieceMove"
          style="width: {{item.widthPx}}px; height: {{item.heightPx}}px; z-index: {{item.layerIndex + 1}};"
        >
          <image wx:if="{{item.imageUrl}}" class="canvas-piece-image" src="{{item.imageUrl}}" mode="aspectFit"></image>
          <view wx:else class="canvas-piece-image mini-placeholder">{{item.category}}</view>
          <view wx:if="{{selectedCanvasItemId === item.id}}" class="piece-label">{{item.subCategory || item.category}}</view>
        </movable-view>
      </block>
    </movable-area>

    <view wx:if="{{selectedCanvasItemId}}" class="selected-bar">
      <text class="selected-text">当前选中：{{selectedCanvasTitle}}</text>
    </view>
  </view>

  <view class="tray-section animate-fade-in" style="animation-delay: 0.1s;">
    <view class="tray-header flex-row justify-between items-center">
      <view class="flex-col tray-copy">
        <text class="text-h2">衣橱单品</text>
        <text class="text-caption">点击加入画布，重复单品不会重复添加</text>
      </view>
      <text class="tray-count">{{canvasItems.length}} / {{maxCanvasItems}}</text>
    </view>

    <view wx:if="{{loading}}" class="tray-empty glass-panel">正在加载衣橱...</view>
    <view wx:elif="{{closetItems.length === 0}}" class="tray-empty glass-panel">暂无已入库单品，先去确认单品吧。</view>
    <view wx:else class="tray-grid">
      <block wx:for="{{closetItems}}" wx:key="id">
        <view class="tray-card glass-panel {{item.addedToCanvas ? 'tray-card-active' : ''}}" bindtap="addClosetItem" data-id="{{item.id}}">
          <image wx:if="{{item.imageUrl}}" class="tray-image" src="{{item.imageUrl}}" mode="aspectFill"></image>
          <view wx:else class="tray-image mini-placeholder">{{item.category}}</view>
          <view class="tray-meta">
            <view class="flex-row justify-between items-center">
              <text class="tray-title">{{item.title}}</text>
              <text class="tray-badge" wx:if="{{item.addedToCanvas}}">已加入</text>
            </view>
            <text class="tray-sub">{{item.category}}</text>
          </view>
        </view>
      </block>
    </view>
  </view>
</scroll-view>
